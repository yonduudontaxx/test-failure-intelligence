{
  "name": "test-failure-intelligence-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src tests --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=tests/integration --passWithNoTests --runInBand",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down 1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^18.0.9",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "http-errors": "^2.0.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "allure-jest": "^3.14.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^30.5.2",
    "node-pg-migrate": "^8.0.4",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
